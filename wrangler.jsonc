{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ahmad",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "244e7d88-1c5c-47ee-b7db-f376d9f28896","database_name": "web-app2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "025c40fe7ea44333b10263fa77ce99a4" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
